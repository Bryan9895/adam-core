{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Adam ToolResult 0.1",
  "type": "object",
  "required": [
    "schema_version",
    "task_id",
    "action_id",
    "status",
    "verified",
    "elapsed_ms",
    "evidence",
    "error_code"
  ],
  "properties": {
    "schema_version": {
      "const": "0.1"
    },
    "task_id": {
      "type": "string",
      "format": "uuid"
    },
    "action_id": {
      "type": "string",
      "format": "uuid"
    },
    "status": {
      "enum": [
        "completed",
        "failed",
        "blocked",
        "cancelled",
        "timed_out",
        "needs_user"
      ]
    },
    "verified": {
      "type": "boolean"
    },
    "elapsed_ms": {
      "type": "integer",
      "minimum": 0
    },
    "evidence": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "kind",
          "ref"
        ],
        "properties": {
          "kind": {
            "enum": [
              "process",
              "window",
              "event",
              "log",
              "metric"
            ]
          },
          "ref": {
            "type": "string",
            "maxLength": 256
          }
        },
        "additionalProperties": false
      }
    },
    "error_code": {
      "type": [
        "string",
        "null"
      ]
    }
  },
  "additionalProperties": false
}
